# ===================================================================
# SoundChain Frontend Environment Configuration (.env.example)
# Copy this file to .env.local to configure custom credentials.
# NOTE: DO NOT COMMIT REAL API KEYS OR PRIVATE KEYS TO VERSION CONTROL.
# ===================================================================

# Optional: Pinata IPFS Gateway JWT for pinning real audio masters to global IPFS.
# If omitted or empty, SoundChain automatically runs with its built-in
# deterministic client-side IPFS CIDv1 generator & simulated gateway node.
VITE_PINATA_JWT=

# Optional: Custom Oracle Validator Key for Listen-to-Earn ($LSTN) ECDSA signatures.
# Defaults to Hardhat Account #0 test key for local development (Chain ID 31337).
VITE_ORACLE_VALIDATOR_KEY=
