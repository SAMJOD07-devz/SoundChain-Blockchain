pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";

/**
 * @title ListenToken
 * @notice ERC-20 token (ListenCoin / LSTN) awarded to users for listening to tracks on SoundChain.
 * @dev Enforces a maximum supply cap of 1,000,000 LSTN, tracks user listening counts,
 * and validates cryptographic stream proofs (anti-bot audio verification) signed by authorized validator nodes.
 */
contract ListenToken is ERC20, Ownable {
    using ECDSA for bytes32;

    // Maximum token supply: 1,000,000 LSTN (18 decimals)
    uint256 public constant MAX_SUPPLY = 1_000_000 * 10**18;

    // Minimum verified playback duration required to qualify for reward minting
    uint256 public constant MIN_STREAM_SECONDS = 10;

    // Configurable reward per listening session (default 10 LSTN)
    uint256 public rewardPerListen;

    // Address of the authorized stream validation authority / oracle
    address public streamValidator;

    // Tracking total listens per user wallet address
    mapping(address => uint256) private _totalListens;

    // Replay attack prevention: records consumed stream proof message hashes
    mapping(bytes32 => bool) public usedProofHashes;

    // Events
    event ListenerRewarded(address indexed listener, uint256 amount, uint256 newTotalListens);
    event RewardPerListenUpdated(uint256 oldReward, uint256 newReward);
    event StreamValidatorUpdated(address indexed oldValidator, address indexed newValidator);
    event StreamProofVerified(
        address indexed listener,
        bytes32 indexed trackId,
        uint256 listenSeconds,
        uint256 nonce,
        bytes32 proofHash
    );

    // Custom errors
    error MaxSupplyExceeded(uint256 requestedAmount, uint256 currentSupply, uint256 maxSupply);
    error InvalidListenerAddress();
    error InvalidRewardAmount();
    error InsufficientStreamDuration(uint256 provided, uint256 minimum);
    error ProofAlreadyConsumed(bytes32 proofHash);
    error InvalidStreamProofSignature();
    error ValidatorNotConfigured();

    constructor() ERC20("ListenCoin", "LSTN") Ownable() {
        // Default reward: 10 LSTN
        rewardPerListen = 10 * 10**18;
        // Default stream validator is deployer owner
        streamValidator = msg.sender;
    }

    /**
     * @notice Allows protocol owner to designate or rotate the authorized cryptographic stream validator address.
     * @param _validator Address of the new validator signing oracle.
     */
    function setStreamValidator(address _validator) external onlyOwner {
        if (_validator == address(0)) {
            revert InvalidListenerAddress();
        }
        address oldValidator = streamValidator;
        streamValidator = _validator;
        emit StreamValidatorUpdated(oldValidator, _validator);
    }

    /**
     * @notice Rewards a listener upon submitting a cryptographically signed stream proof from the audio engine.
     * @param listener The wallet address of the listener receiving the tokens.
     * @param trackId Unique bytes32 identifier of the streamed master recording.
     * @param listenSeconds Number of seconds the audio session actively played.
     * @param nonce Unique random/sequential nonce to prevent replay attacks.
     * @param signature Cryptographic ECDSA signature generated by the authorized stream validator.
     */
    function rewardListenerWithProof(
        address listener,
        bytes32 trackId,
        uint256 listenSeconds,
        uint256 nonce,
        bytes calldata signature
    ) external {
        if (listener == address(0)) {
            revert InvalidListenerAddress();
        }
        if (listenSeconds < MIN_STREAM_SECONDS) {
            revert InsufficientStreamDuration(listenSeconds, MIN_STREAM_SECONDS);
        }
        if (streamValidator == address(0)) {
            revert ValidatorNotConfigured();
        }
        if (totalSupply() + rewardPerListen > MAX_SUPPLY) {
            revert MaxSupplyExceeded(rewardPerListen, totalSupply(), MAX_SUPPLY);
        }

        // Compute unique session proof hash bound to this contract, chain ID, listener, track, and nonce
        bytes32 messageHash = keccak256(
            abi.encodePacked(listener, trackId, listenSeconds, nonce, block.chainid, address(this))
        );

        if (usedProofHashes[messageHash]) {
            revert ProofAlreadyConsumed(messageHash);
        }

        // Verify cryptographic signature against authorized validator
        bytes32 ethSignedHash = messageHash.toEthSignedMessageHash();
        address recoveredSigner = ethSignedHash.recover(signature);

        if (recoveredSigner != streamValidator) {
            revert InvalidStreamProofSignature();
        }

        // Consume proof to guarantee zero replay
        usedProofHashes[messageHash] = true;
        _totalListens[listener] += 1;

        _mint(listener, rewardPerListen);

        emit StreamProofVerified(listener, trackId, listenSeconds, nonce, messageHash);
        emit ListenerRewarded(listener, rewardPerListen, _totalListens[listener]);
    }

    /**
     * @notice Mints reward tokens to a listener directly (Admin / Owner fallback).
     * @param listener The wallet address of the listener.
     */
    function rewardListener(address listener) external onlyOwner {
        if (listener == address(0)) {
            revert InvalidListenerAddress();
        }
        if (totalSupply() + rewardPerListen > MAX_SUPPLY) {
            revert MaxSupplyExceeded(rewardPerListen, totalSupply(), MAX_SUPPLY);
        }

        _totalListens[listener] += 1;
        _mint(listener, rewardPerListen);

        emit ListenerRewarded(listener, rewardPerListen, _totalListens[listener]);
    }

    /**
     * @notice Updates the reward per listen amount (Admin only).
     * @param newReward Amount in wei (taking 18 decimals into account).
     */
    function setRewardPerListen(uint256 newReward) external onlyOwner {
        if (newReward == 0) {
            revert InvalidRewardAmount();
        }
        uint256 oldReward = rewardPerListen;
        rewardPerListen = newReward;
        emit RewardPerListenUpdated(oldReward, newReward);
    }

    /**
     * @notice Returns the total number of verified listens completed by a user.
     * @param listener Wallet address to query.
     */
    function totalListens(address listener) external view returns (uint256) {
        return _totalListens[listener];
    }
}
